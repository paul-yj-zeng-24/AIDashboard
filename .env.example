# Copy to .env and fill in. Any OpenAI-compatible provider works
# (same variable names as datawhale-hello_agents, so you can reuse that .env).
LLM_API_KEY=your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_ID=gpt-4o-mini

# Optional: a cheaper model for repetitive work (inbox triage, from Phase 3).
# Leave empty to use LLM_MODEL_ID for everything.
LLM_FAST_MODEL_ID=

# Optional: where you live. Used by the weather tool and the system prompt.
HOME_NAME=Berkeley, CA
HOME_LATITUDE=37.8716
HOME_LONGITUDE=-122.2727
TIMEZONE=America/Los_Angeles
# fahrenheit or celsius
TEMPERATURE_UNIT=fahrenheit
